{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spanler-com",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-03",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spanler-content",
      "database_id": "2cc5b1ca-d01e-4b4d-9218-c65aa8bd0972",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "spanler-media" },
    { "binding": "CHAT_LOGS", "bucket_name": "spanler-chat-logs" },
  ],
  "vars": {
    "SITE_URL": "https://spanler.com",
    "AI_MODEL": "llama-3.3-70b-versatile",
    "AI_DAILY_LIMIT": "100",
    "AI_MONTHLY_LIMIT": "1000",
    "AI_MAX_OUTPUT_TOKENS": "400",
    "CHAT_RETENTION_DAYS": "30",
    "AI_ENABLED": "false",
    "NOCODB_MODE": "records",
    "NOTIFY_EMAIL": "zzy4628@gmail.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFzECDbSrzWs8rXE",
  },
}
